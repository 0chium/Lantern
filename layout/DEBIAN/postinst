#!/bin/sh
# Reload the camera capture process after installation or upgrade so the
# warm-LED hook is loaded without requiring a device reboot.
# Do not fail package configuration if the service is not running.
if [ "${1:-}" = "configure" ]; then
    if [ -x /var/jb/usr/bin/killall ]; then
        /var/jb/usr/bin/killall -TERM cameracaptured >/dev/null 2>&1 || :
    elif command -v killall >/dev/null 2>&1; then
        killall -TERM cameracaptured >/dev/null 2>&1 || :
    fi
fi
exit 0
